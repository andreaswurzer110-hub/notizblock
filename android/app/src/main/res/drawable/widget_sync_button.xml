<?xml version="1.0" encoding="utf-8"?>
<!-- Rahmen für die Zeit-Anzeige, die als "Jetzt synchronisieren"-Button dient.
     Grenzt den Tap-Bereich sichtbar vom danebenliegenden Haus-Button ab.
     Halbtransparentes Grau ist auf hellen wie dunklen Notizfarben erkennbar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <stroke
        android:width="1dp"
        android:color="#80888888" />
    <solid android:color="#22888888" />
</shape>
