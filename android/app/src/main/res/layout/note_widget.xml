<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- "Jetzt synchronisieren" wie im Widget von Wetter AW: Zeit + Pfeil,
             der ganze Bereich ist der Knopf (Klick -> Hintergrund-Sync, siehe
             NoteWidgetProvider; Tippen auf die Zeit geht also weiterhin).
             NUR nach einem Tipp hier dreht statt des Pfeils ein Ladekreis –
             automatische Abgleiche (App, stündlich) zeigen nichts an. -->
        <LinearLayout
            android:id="@+id/widget_sync_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="2dp"
            android:contentDescription="@string/widget_sync">

            <TextView
                android:id="@+id/widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#888888"
                android:singleLine="true" />

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp">

                <ImageView
                    android:id="@+id/widget_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="5dp"
                    android:src="@drawable/ic_refresh"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />

                <!-- Zwei Ladekreise statt Tönung per Code: ProgressBar-Farben
                     lassen sich über RemoteViews erst ab Android 12 setzen. -->
                <ProgressBar
                    android:id="@+id/widget_sync_progress_dark"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="#8A000000"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/widget_sync_progress_light"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="#B3FFFFFF"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_menu"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_home"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_home" />

    </LinearLayout>

    <TextView
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:textColor="#666666"
        android:maxLines="1000"
        android:ellipsize="end" />

</LinearLayout>
