<?xml version="1.0" encoding="utf-8"?>
<!-- Ordner-Widget: Symbol + Anzahl in einer schmalen Kopfzeile OBEN, der
     Ordnername darunter über die volle Breite. Vorher lagen alle drei
     nebeneinander – dann blieb dem Namen nur ein Drittel der Breite (viele
     Umbrüche) und oben/unten stand der Platz leer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/folder_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_folder"
            android:scaleType="fitCenter"
            android:contentDescription="@string/folder_widget_name" />

        <TextView
            android:id="@+id/folder_widget_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="end"
            android:textSize="11sp"
            android:textColor="#888888"
            android:singleLine="true" />

    </LinearLayout>

    <TextView
        android:id="@+id/folder_widget_name"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical|start"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:lineSpacingMultiplier="0.95"
        android:maxLines="4"
        android:ellipsize="end" />

</LinearLayout>
