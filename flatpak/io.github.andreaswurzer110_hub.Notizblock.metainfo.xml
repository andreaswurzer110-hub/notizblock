<component type="desktop-application">
  <id>io.github.andreaswurzer110_hub.Notizblock</id>

  <name>Notizblock AW</name>
  <summary>Schlichte Notizen mit Sticky-Fenstern und Drive-Sync</summary>
  <summary xml:lang="en">Simple notes with sticky windows and Drive sync</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <developer id="io.github.andreaswurzer110_hub">
    <name>Andreas Wurzer</name>
  </developer>

  <description>
    <p>
      Notizblock ist eine schlichte, plattformübergreifende App für reine
      Text-Notizen – ohne Markdown, Bilder oder Checklisten. Der Fokus liegt
      auf schnellem Festhalten und Wiederfinden.
    </p>
    <p>Funktionen:</p>
    <ul>
      <li>Reine Text-Notizen mit Farben und Anheften</li>
      <li>Sticky-Note-Fenster auf dem Desktop (frei platzierbar)</li>
      <li>Google-Drive-Sync für den Abgleich zwischen Geräten (Android, Windows, Linux)</li>
      <li>Archivieren und Wiederherstellen</li>
      <li>Mehrsprachig, Deutsch als Standard</li>
    </ul>
    <p xml:lang="en">
      Notizblock is a simple cross-platform app for plain text notes — no
      Markdown, images or checklists. It focuses on quickly capturing and
      finding notes.
    </p>
    <ul xml:lang="en">
      <li>Plain text notes with colors and pinning</li>
      <li>Sticky note windows on the desktop</li>
      <li>Google Drive sync across devices (Android, Windows, Linux)</li>
      <li>Archive and restore</li>
      <li>Multilingual, German by default</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.andreaswurzer110_hub.Notizblock.desktop</launchable>

